# ---- run selection -----------------------------------------------------------
# PLATFORM: android | ios
PLATFORM=android
# CLOUD: local | sauce | browserstack
CLOUD=local
# Optional run label (defaults to GITHUB_RUN_ID or a timestamp)
BUILD_NAME=

# ---- local emulator / simulator -----------------------------------------------
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=
IOS_DEVICE_NAME=iPhone 16
IOS_PLATFORM_VERSION=
# Optional: pin a specific booted simulator (CI sets this)
IOS_UDID=
# Override app locations (defaults point at apps/ after `npm run apps:download`)
APP_ANDROID=
APP_IOS=
APPIUM_PORT=4723

# ---- Sauce Labs (real devices) — set as GitHub secrets, never commit ----------
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_REGION=us-west-1
# Device selection (regex allowed, e.g. "Google Pixel.*")
SAUCE_ANDROID_DEVICE=Google Pixel.*
SAUCE_IOS_DEVICE=iPhone.*
# App references after `npm run apps:upload` (storage:filename=... or storage:<id>)
SAUCE_ANDROID_APP=storage:filename=android.wdio.native.app.v2.2.0.apk
SAUCE_IOS_APP=storage:filename=ios.real.wdio.native.app.ipa

# ---- BrowserStack (real devices) — set as GitHub secrets, never commit --------
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_ANDROID_DEVICE=Google Pixel 8
BROWSERSTACK_ANDROID_OS=14.0
BROWSERSTACK_IOS_DEVICE=iPhone 15
BROWSERSTACK_IOS_OS=17
# bs://<hash> values returned by `npm run apps:upload`
BROWSERSTACK_ANDROID_APP=
BROWSERSTACK_IOS_APP=

{
  "name": "appium-mobile-cloud",
  "version": "0.1.0",
  "description": "Appium + WebdriverIO (TypeScript) mobile framework: iOS and Android suites, one env-selected profile for local emulator/simulator, Sauce Labs and BrowserStack real-device clouds.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Yassine Ait Tamarmoucht",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yassineaitt/appium-mobile-cloud.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "prepare": "husky",
    "test": "wdio run config/wdio.conf.ts",
    "test:android": "PLATFORM=android wdio run config/wdio.conf.ts",
    "test:ios": "PLATFORM=ios wdio run config/wdio.conf.ts",
    "test:smoke": "wdio run config/wdio.conf.ts --mochaOpts.grep @smoke",
    "test:unit": "vitest run",
    "apps:download": "bash scripts/download-apps.sh",
    "apps:upload": "bash scripts/upload-apps.sh",
    "appium:setup": "appium driver install uiautomator2 && appium driver install xcuitest",
    "appium:doctor": "appium driver doctor uiautomator2 && appium driver doctor xcuitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "typescript",
    "mobile-testing",
    "ios",
    "android",
    "sauce-labs",
    "browserstack"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/junit-reporter": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/sauce-service": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/types": "^10.1.0",
    "appium": "^3.9.0",
    "appium-uiautomator2-driver": "^8.7.3",
    "appium-xcuitest-driver": "^12.22.4",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-wdio": "^10.1.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "webdriverio": "^10.1.0",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml,sh}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
